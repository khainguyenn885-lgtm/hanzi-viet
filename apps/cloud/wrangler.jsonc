{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoc-tieng-trung-cung-khai",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoc-tieng-trung-cung-khai",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "2026110302", "simple": { "limit": 10, "period": 60 } }
  ]
}
